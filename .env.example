# ai-image-analysis - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# =============================================================================
# REQUIRED
# =============================================================================

# Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# =============================================================================
# OPTIONAL (with sensible defaults)
# =============================================================================

# Gemini model to use (default: gemini-2.5-pro)
# GEMINI_MODEL=gemini-2.5-pro

# AI Detection Model
# Path to locally downloaded model directory (optional - falls back to HuggingFace)
# AI_MODEL_PATH=/path/to/local/model
